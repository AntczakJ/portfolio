{
  "name": "portfolio",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Production-grade portfolio monorepo of Jan Antczak — each subfolder in projects/* is an independent showcase.",
  "author": "Jan Antczak <janek.antczak@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "lint": "pnpm -r --if-present lint && eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "meld:e2e": "pnpm -F meld-e2e test",
    "meld:e2e:smoke": "pnpm -F meld-e2e test --grep @smoke"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.6",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  },
  "lint-staged": {
    "projects/tape/server/**/*.{ts,tsx,js,mjs,cjs}": "pnpm -F tape-server lint --fix --quiet",
    "projects/tape/web/**/*.{ts,tsx,js,mjs,cjs}": "pnpm -F tape-web lint --fix --quiet",
    "*.{ts,tsx,js,jsx,mjs,cjs}": "eslint --fix --quiet",
    "*.{json,md,yml,yaml,css}": "prettier --write"
  }
}
