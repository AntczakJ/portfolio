# meld-server environment variables (Phase 1 placeholders).
#
# Copy to .env (git-ignored) and fill in. Never commit .env.
#
# Principle (see ../README.md + per-project AGENT_NOTES.md "no fallbacks for
# absent env vars on hot paths"): the server fails fast at startup if a
# required var is missing. We never silently default DATABASE_URL or the
# WebSocket origin allowlist to something that would be wrong in production.
# Task 1.1 does not yet read any of the env vars below at boot — they are
# declared here so subsequent Phase 1 tasks (1.2 Drizzle, 1.4 Hocuspocus,
# 1.5 retention) inherit a single source of intent.

# Hono HTTP listen port. Default 3002 (Next dev server owns 3000; tape uses
# 3001 — meld picks the next free slot to allow running tape + meld
# in parallel during cross-project work).
PORT=3002

# Node-style runtime mode. One of 'development' | 'test' | 'production'.
# Affects log verbosity (future), CORS allowlist policy (ADR-002 fails closed
# in production, falls open to http://localhost:3000 only in development),
# and drizzle-kit tooling (future Task 1.2).
NODE_ENV=development

# Postgres connection string consumed by Drizzle (lands in Task 1.2). Mila
# already owns 5434 and tape owns 5435 per cross-project AGENT_NOTES, so
# meld picks 5436. The docker-compose.yml shipped by Task 1.2 will bind
# the local Postgres to this port.
DATABASE_URL=postgres://meld:meld@localhost:5436/meld

# WebSocket / HTTP CORS Origin allowlist (ADR-002). Comma-separated absolute
# origins, no wildcards. Shared by the Hono HTTP CORS layer and the
# Hocuspocus onConnect Origin check. In production (NODE_ENV=production) an
# empty or unset value fails the server boot — there is no permissive
# default. In development an empty value falls open to http://localhost:3000
# only, never to "*". Task 1.4 wires this; Task 1.1 only documents.
MELD_ALLOWED_ORIGINS=http://localhost:3000

# Hocuspocus onStoreDocument debounce window (ADR-003). 5_000 ms = idle
# window — flush the per-board snapshot when no new ops arrive for 5 s. Wired
# in Task 1.4.
WS_DEBOUNCE_MS=5000

# Hocuspocus onStoreDocument max-debounce ceiling (ADR-003). 30_000 ms = max
# time between snapshot flushes regardless of activity. Without this, a
# board receiving a steady trickle of ops at < 100 / 5 s would never snapshot
# and crash-recovery would have to walk a longer ops chain on rehydrate.
WS_MAX_DEBOUNCE_MS=30000

# In-memory per-board ops-counter early-flush threshold (ADR-003). When the
# adapter's counter crosses this value since the last flush, it triggers
# Hocuspocus's Document.save() early. Caps the worst-case rehydrate chain at
# this many ops between snapshots. Wired in Task 1.3.
WS_OPS_FLUSH_THRESHOLD=100

# Inactive-board retention horizon in whole days (ADR-003). Nightly sweep
# deletes boards with last_active_at older than this many days; the ON
# DELETE CASCADE foreign key on board_ops removes the associated ops in the
# same transaction. Wired in Task 1.5.
BOARD_RETENTION_DAYS=30

# Periodic compaction-sweep ops-backlog threshold (ADR-003 backstop —
# Task 1.5). The 6 h rolling sweep inspects each in-memory Hocuspocus room
# and triggers Hocuspocus's `storeDocumentHooks(document, payload, true)`
# early-flush for any room whose un-flushed ops count (MAX(op_seq) -
# last_compacted_op_seq) exceeds this value. The in-adapter early-flush
# from Task 1.3 catches most rooms at WS_OPS_FLUSH_THRESHOLD ops; this
# sweep is the backstop for rooms that fall outside the framework's
# debounce window. Default 100. Wired in Task 1.5.
WS_COMPACTION_OPS_THRESHOLD=100
