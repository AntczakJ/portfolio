{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "noEmit": true,
    "rootDir": ".",
    "paths": {
      "@helpers/*": ["./helpers/*"]
    },
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve"
  },
  "include": ["playwright.config.ts", "tests/**/*.ts", "helpers/**/*.ts", "env.d.ts"],
  "exclude": ["node_modules", "playwright-report", "test-results"]
}
