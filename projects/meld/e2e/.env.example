# meld-e2e — environment variables for local + CI runs.
#
# Copy to `.env.test` (gitignored) when running locally against a non-default
# URL. Playwright reads `process.env.BASE_URL` (and `MELD_E2E_TARGET_URL` as
# an ADR-007-compatible alias) via the Zod-parsed env loader in
# `playwright.config.ts`.
#
# The defaults below point at the local dev stack started by
# `pnpm -F meld dev:server` + `pnpm -F meld dev:web` on the canonical
# `meld-server` HTTP port (3099) and `meld-web` port (3055).

# HTTP origin of meld-web (the Next.js app under test).
# Production: https://meld-demo.fly.dev
BASE_URL=http://localhost:3055

# WebSocket origin of meld-server. Used by the multi-user-presence
# test's WS frame inspection helper (`page.on('websocket')`). When the
# production deploy uses a single-origin reverse-proxy (meld-demo.fly.dev),
# WS lives on `wss://meld-demo.fly.dev/ws/board/:id` and this variable
# stays in lockstep with BASE_URL.
WS_BASE_URL=ws://localhost:3099

# Backend HTTP origin — only different from BASE_URL when meld-web and
# meld-server are running on separate ports in dev (the canonical local
# split). In production both flow through the same origin.
API_BASE_URL=http://localhost:3099

# ADR-007 compatibility alias — the GitHub Actions workflow sets
# MELD_E2E_TARGET_URL from the workflow_dispatch input. The config
# prefers BASE_URL when both are set; CI sets only MELD_E2E_TARGET_URL.
# MELD_E2E_TARGET_URL=https://meld-demo.fly.dev
