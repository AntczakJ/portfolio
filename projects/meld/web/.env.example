# Public client-side configuration for meld-web.
#
# v2 deploy collapses both URLs to the same hostname behind a Hono
# catch-all reverse proxy (same pattern as tape Phase 6) — the WS
# upgrade and the HTTP control routes share an origin, which keeps the
# WS Origin allowlist (MELD_ALLOWED_ORIGINS on the server) tight to a
# single value in production.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
