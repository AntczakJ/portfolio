    "motion": "^12.40.0",
    "next": "^15.5.18",
    "next-themes": "^0.4.6",
    "pmtiles": "^4.4.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.1",
    "tailwind-merge": "^3.6.0",
