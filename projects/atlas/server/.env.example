# atlas-server environment variables.
#
# Copy to .env (git-ignored) and fill in. Never commit .env.
#
# Principle (the pulse/meld/tape fail-fast posture): the server validates the
# environment at boot against a Zod schema (src/config/env.schema.ts). A missing
# or malformed REQUIRED var aborts the boot with a precise message rather than
# failing deep in a request later. We never silently default DATABASE_URL to a
# value that would be wrong in production.
#
# ---------------------------------------------------------------------------
# Port hygiene (AGENT_NOTES, CORRECTED by the architect — the planner's
# 3090/3091 COLLIDE with apex slot 5). Confirmed picks:
#   tape   API 3001 / pg 5435        meld  API 3002 / pg 5436
#   razors-edge web 3070             pulse API 3080 / web 3081 / pg 5437
#   apex   web 3090 / e2e 3091       Mila  pg 5434
#   atlas (here)  server 3092 / web 3093 / pg 5438
# NO Redis: the simulation is a single in-process loop, no broker (ADR-002/007).
# ---------------------------------------------------------------------------

# --- Phase 1: core runtime ---

# Fastify HTTP/WS listen port. The server binds 0.0.0.0:PORT in dev. 3092 is the
# atlas server slot (3090/3091 are apex's web + e2e).
PORT=3092

# Node-style runtime mode. One of 'development' | 'test' | 'production'.
# Affects log verbosity and the CORS posture.
NODE_ENV=development

# --- Phase 1: persistence (ADR-005) ---

# Postgres connection string consumed by Drizzle and the runtime DB client. The
# local docker-compose.yml binds Postgres to 5438 (see the port-hygiene block).
# In production this points at Fly Postgres. Plain Postgres — no PostGIS in v1
# (the authoritative geo is computed in-engine via turf; PostGIS is the clean
# v2 upgrade — ADR-005).
DATABASE_URL=postgres://atlas:atlas@localhost:5438/atlas

# --- Phase 2/4: cross-origin dev posture ---

# Comma-separated allowlist of browser origins permitted to call the REST read
# surface and open the WebSocket. DEV: the atlas-web dev origin (:3093). In a
# PROD single-origin reverse-proxy posture this is effectively unused; set it to
# the prod web origin (or empty) there. Never `*` with credentials.
CORS_ORIGINS=http://localhost:3093

# --- Phase 9: deploy provenance (optional) ---

# Short git SHA surfaced by GET /health. CI / container builds set this; in
# local dev the server falls back to `git rev-parse` then 'dev'. Named with the
# ATLAS_ prefix so a shared CI building several projects does not collide.
# ATLAS_COMMIT_SHA=
