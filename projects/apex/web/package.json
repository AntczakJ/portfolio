{
  "name": "apex-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "APEX — Next.js 15 web showcase. Premium-modern / EV car-rental marketing site with an interactive 3D configurator and a mocked multi-step reservation flow.",
  "scripts": {
    "dev": "next dev -p 3090",
    "build": "next build",
    "start": "next start -p 3090",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:lh": "lhci autorun --config=lighthouserc.json",
    "test:lh:mobile": "lhci autorun --config=lighthouserc.mobile.json",
    "mocks:bake": "node scripts/bake-mocks.mjs",
    "model:inspect": "node scripts/inspect-model.mjs",
    "model:optimize": "node scripts/optimize-model.mjs",
    "model:verify": "node scripts/verify-model.mjs",
    "renders:scene": "node scripts/render-from-scene.mjs",
    "assets:sections": "node scripts/generate-section-assets.mjs",
    "og:image": "node scripts/generate-og-image.mjs",
    "verify:reserve": "node scripts/verify-reserve.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "@tanstack/react-query": "^5.100.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.13.0",
    "lucide-react": "^1.16.0",
    "next": "^16.2.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.180.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "browserslist": [
    "chrome >= 100",
    "edge >= 100",
    "firefox >= 100",
    "safari >= 15.4",
    "ios_saf >= 15.4",
    "not dead"
  ],
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@faker-js/faker": "^10.4.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.60.0",
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@hookform/resolvers": "^5.1.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint-config-next": "^15.5.18",
    "jsdom": "^25.0.1",
    "meshoptimizer": "^1.1.1",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
