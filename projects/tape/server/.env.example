# tape-server environment variables (Phase 1 placeholders).
#
# Copy to .env (git-ignored) and fill in. Never commit .env.
#
# Principle (see ../README.md): no fallbacks for absent env vars on hot
# paths. The server fails fast at startup if a required var is missing —
# we never silently default DATABASE_URL or BRIDGE_PATH to something
# wrong in production.

# Elysia HTTP listen port. Default 3001 (Next dev server owns 3000).
PORT=3001

# Node-style runtime mode. Elysia / Bun do not depend on this, but tooling
# (drizzle-kit migrations, future test runners) keys off it. One of
# 'development' | 'test' | 'production'.
NODE_ENV=development

# Postgres connection string consumed by Drizzle (Task 1.2). Postgres runs
# on a non-conflicting port — Mila already owns 5434 per AGENT_NOTES.md,
# so tape uses 5435.
DATABASE_URL=postgres://tape:tape@localhost:5435/tape

# Binance USDM Futures WebSocket base. Single stream subscriptions append
# `/<symbol>@<stream>` per ADR-001. Public, unauthenticated, no per-symbol
# rate limit for v1 single-symbol scope. Misconfiguration (bad protocol,
# malformed URL) is detected at ingest start and aborts the boot — the
# ingestor does NOT silently retry against a default that would hide the
# bug.
BINANCE_WS_URL=wss://fstream.binance.com/ws

# Lowercase Binance symbol slug appended to the stream URL. v1 is
# single-symbol BTC-PERP. Acceptable values are lowercase ASCII
# letters / digits / underscore.
BINANCE_SYMBOL=btcusdt

# Real Binance ingest on / off (Task 1.3). Defaults to '1' — the real
# feed is the v1 production source. Flip to '0' for offline reproduction,
# deterministic UI work, or CI loops that must not depend on the public
# Binance feed. When '0', set WS_SYNTHESIZE=1 to drive frames into the
# WS registry from the in-process deterministic synthesizer.
#
# Mutex policy: the synthesizer and the real ingestor publish to the SAME
# registry under the SAME topic, so they are mutually exclusive. If both
# env vars are set to '1', the boot path picks the real ingest and logs a
# WARN — silently disabling the synthesizer is the lower-surprise outcome
# than disabling the real feed.
BINANCE_WS_ENABLED=1

# Worker pipeline mode (Task 1.5). When '1', the Rust `worker` binary is
# spawned at boot, the bridge client connects, and every Binance aggTrade
# is pushed through the worker for cell aggregation. The worker emits
# `cell.delta` / `cell.close` frames back over the bridge and the server
# fans them out to WS clients. When '0' (the default during the v1
# soft-launch), the ingestor falls back to direct tick broadcasts only —
# the tape strip is populated but cells are empty (v1.0 limitation cited
# in README's "Live Binance ingestion" section).
#
# Three-way mutex precedence:
#   1. BINANCE_WS_ENABLED=1 + WORKER_PIPELINE_ENABLED=1  → full pipeline
#   2. BINANCE_WS_ENABLED=1 + WORKER_PIPELINE_ENABLED=0  → tape strip only
#   3. WS_SYNTHESIZE=1 + BINANCE_WS_ENABLED=0            → dev synth path
#                                                          (worker NOT in loop)
#
# If both BINANCE_WS_ENABLED=1 and WS_SYNTHESIZE=1, BINANCE_WS_ENABLED
# wins and the synth is silently disabled. WORKER_PIPELINE_ENABLED is
# orthogonal to the synth — synth never feeds the bridge.
WORKER_PIPELINE_ENABLED=0

# Deterministic in-process synthesizer toggle (Task 1.6a). When '1' the
# server publishes a slow ~5 ticks/sec stream into the WS registry under
# the same `ticks.btc` topic as the real Binance ingest — useful for
# offline UI work, CI, and screenshots. Defaults to '0'.
#
# Three-way mutex precedence (mirrors the WORKER_PIPELINE_ENABLED doc
# below; canonical reference: PROGRESS.md "Phase 1 Tasks 1.5b / 1.6a" +
# AGENT_NOTES.md "Mutex policy"):
#   1. BINANCE_WS_ENABLED=1                            → real Binance feed wins
#   2. BINANCE_WS_ENABLED=0 + WS_SYNTHESIZE=1          → dev synth path
#   3. BINANCE_WS_ENABLED=0 + WS_SYNTHESIZE=0          → no live producer (silent)
# If BOTH BINANCE_WS_ENABLED=1 and WS_SYNTHESIZE=1 are set, the real feed
# wins and the synth is silently disabled (the boot path logs a WARN).
WS_SYNTHESIZE=0

# Optional integer seed for the synthesizer's LCG. Defaults to
# SYNTH_DEFAULT_SEED = 1 (see `src/lib/ws/synthesizer.ts`). Two boots
# with the same seed produce identical tick streams — essential for
# screenshot regression tests and deterministic CI runs. Leave unset
# unless reproducing a specific captured run.
# WS_SYNTHESIZE_SEED=1

# Rust hot-path worker bridge endpoint (ADR-002). Resolves to a Unix domain
# socket path on Linux and a named pipe on Windows. The runtime
# abstraction in `src/lib/bridge/path.ts` (TS) and `bridge/transport.rs`
# (Rust) picks the right per-OS DEFAULT when this var is UNSET:
#   Linux/macOS: /tmp/tape-bridge.sock
#   Windows:     \\.\pipe\tape-bridge   (the \\.\pipe\ prefix is REQUIRED —
#                a single-backslash form fails the interprocess crate's
#                named-pipe path check on the Rust listener side)
# Leave this COMMENTED for local dev so the per-OS default applies and the
# same .env works on both the owner's Windows machine and the Linux deploy.
# Only set it to pin a fixed path in a production container (a real UDS
# path on Linux, e.g. /run/tape/bridge.sock).
# BRIDGE_PATH=/run/tape/bridge.sock

# Optional: absolute path to the Rust worker binary the supervisor
# spawns when WORKER_PIPELINE_ENABLED=1. When set, this overrides the
# default lookup. When unset, the supervisor resolves to
#   `<repo>/projects/tape/worker/target/<profile>/worker[.exe]`
# where `<profile>` is `release` if BRIDGE_WORKER_PROFILE=release else
# `debug`. Production containers that copy a prebuilt binary into a
# non-standard path should set this; local dev should leave it unset
# and rely on `cargo build --bin worker`.
# BRIDGE_WORKER_BIN=/usr/local/bin/tape-worker

# Optional: pick which Rust binary the supervisor spawns when
# WORKER_PIPELINE_ENABLED=1. `release` selects target/release/worker[.exe],
# anything else (default) selects target/debug/worker[.exe]. Production
# containers should set this to `release`; local dev defaults to `debug`
# so a `cargo build --bin worker` is enough to pick up changes.
# BRIDGE_WORKER_PROFILE=release

# Optional: short git SHA stamped into the /health response. CI / container
# builds inject this; in local dev the server falls back to `git rev-parse`
# and then to the literal 'dev'. Leave unset for local development.
# TAPE_COMMIT_SHA=

# CORS allowlist (Phase 6 deploy hardening). Comma-separated list of
# origins (`scheme://host[:port]`) that are allowed to fetch this
# server from a different origin. Same-origin requests bypass CORS
# entirely.
#
# Policy when unset:
#   - NODE_ENV !== 'production': defaults to the localhost dev set
#     (http://localhost:3000, :3001, :3002, :3003) so the owner's
#     laptop workflow does not need .env tweaking.
#   - NODE_ENV === 'production': the allowlist is EMPTY (fail-closed).
#     Every cross-origin request is denied until this var is set.
#     The boot path logs a WARN so the misconfiguration is visible.
#
# Production deploy on Fly.io: set this to the demo URL — e.g.
#   ALLOWED_ORIGINS=https://tape-demo.fly.dev
# If you wire a custom domain, add it too:
#   ALLOWED_ORIGINS=https://tape-demo.fly.dev,https://tape.jan.dev
# Wildcards are NOT supported in v1 — explicit origins only. If you
# need pattern-matching (preview deployments) ship an ADR.
# ALLOWED_ORIGINS=https://tape-demo.fly.dev

# Per-IP WebSocket connection-count cap (Phase 6 deploy hardening).
# Pre-accept limiter that sits in front of the `/ws/stream` upgrade.
# Complements ADR-006's post-accept circuit breaker (256 KB / 2 s) —
# the breaker stops a misbehaving client from monopolising one
# socket's bandwidth; this cap stops a single source IP from opening
# enough sockets to starve other visitors.
#
# Default 5. Generous for real visitors (one browser tab = one
# socket; a power user might have 2-3 tabs + a mobile companion on
# the same NAT'd home IP). Tight enough to make a connection-flood
# attack pay a real cost per source IP.
#
# In-memory + per-process — single Fly Machine only. v2 horizontal
# scale-out would need a shared store (Redis SETNX or Fly's KV).
# Tracked under AGENT_NOTES "Decisions to revisit" as ADR-007
# territory; do not pre-allocate.
# WS_MAX_CONNECTIONS_PER_IP=5
