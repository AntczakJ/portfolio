{
  "name": "tape-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Elysia on Bun control plane for tape — Binance Futures ingestion, footprint aggregation, WebSocket fan-out.",
  "engines": {
    "bun": ">=1.1.0"
  },
  "exports": {
    ".": {
      "types": "./src/app.ts"
    },
    "./ws-schemas": {
      "types": "./src/lib/schemas/ws/index.ts",
      "default": "./src/lib/schemas/ws/index.ts"
    },
    "./replay-schemas": {
      "types": "./src/lib/schemas/replay/index.ts",
      "default": "./src/lib/schemas/replay/index.ts"
    }
  },
  "types": "./src/app.ts",
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "build": "bun build src/server.ts --target=bun --outdir=dist",
    "start": "bun run src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "bridge:generate": "node scripts/bridge-generate.mjs",
    "bridge:check": "node scripts/bridge-check.mjs",
    "bridge:clean": "node scripts/bridge-clean.mjs"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.1.1",
    "@elysiajs/swagger": "^1.1.6",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "elysia": "^1.1.25",
    "msgpackr": "^2.0.4",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "bun-types": "^1.1.34",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.6.3"
  }
}
