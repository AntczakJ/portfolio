# tape-e2e — environment variables for local + CI runs.
#
# Copy to `.env.test` (gitignored) to override. By default the config
# AUTO-STARTS tape-web in dev mode on port 3210 and points BASE_URL at it,
# so the deterministic specs need NO env at all.

# HTTP origin of tape-web under test. Set this to point at an
# already-running server or a deployed URL (disables the auto webServer).
# Production (after deploy): https://tape-demo.fly.dev
# BASE_URL=http://localhost:3210

# CI alias for BASE_URL (the GitHub Actions workflow sets this from the
# workflow_dispatch input). The config prefers BASE_URL when both are set.
# TAPE_E2E_TARGET_URL=https://tape-demo.fly.dev

# WebSocket base origin for the @live spec ONLY (the BASE — the provider
# appends /ws/stream). Derived from BASE_URL when unset.
# WS_BASE_URL=ws://localhost:3011

# Set to 1 to RUN the @live spec against a real running pipeline. Default:
# the @live spec is SKIPPED so the suite is green without Docker.
# TAPE_E2E_LIVE=1

# Set to 0 to DISABLE the auto-started dev webServer (when you have a
# server running already, or you set BASE_URL to a deployed URL).
# TAPE_E2E_WEB_SERVER=0
