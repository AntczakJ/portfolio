# pulse-server environment variables.
#
# Copy to .env (git-ignored) and fill in. Never commit .env.
#
# Principle (mirrors meld/tape AGENT_NOTES "no fallbacks for absent env vars
# on hot paths"): the server fails fast at startup if a required var is
# missing. We never silently default DATABASE_URL / REDIS_URL / the auth
# secret to a value that would be wrong in production. The env is validated
# at boot against a Zod schema (src/config/env.schema.ts) — a missing or
# malformed required var aborts the boot with a precise message.
#
# Every variable in the Phase 1-6 ADR-006 secrets inventory is declared here
# so each phase inherits a single source of intent.
#
# ---------------------------------------------------------------------------
# Port hygiene (AGENT_NOTES "Port hygiene"). Non-colliding picks:
#   tape          API 3001 / Postgres 5435
#   meld          API 3002 / Postgres 5436
#   razors-edge   web 3070
#   Mila          Postgres 5434
#   pulse (here)  API 3080 / Postgres 5437 / Redis 6381
# 6379 = system-default Redis (avoid); 6380 = a common second Redis (avoid).
# ---------------------------------------------------------------------------

# --- Phase 1: core runtime ---

# NestJS HTTP listen port. The server binds 0.0.0.0:PORT. 3080 is the
# pulse dev slot (3000-3002 + 3055-3070 are taken by tape/meld/razors-edge).
PORT=3080

# Node-style runtime mode. One of 'development' | 'test' | 'production'.
# Affects log verbosity, CORS posture, and the demo-trigger guard default.
NODE_ENV=development

# --- Phase 1: persistence (ADR-005) ---

# Postgres connection string consumed by Drizzle and the runtime DB client.
# The local docker-compose.yml binds Postgres to 5437 (see the port-hygiene
# block above). In production this points at Fly Postgres.
DATABASE_URL=postgres://pulse:pulse@localhost:5437/pulse

# --- Phase 1: queue + real-time bridge (ADR-002 / ADR-003) ---

# Redis connection string. Backs BullMQ (the probe / rollup / GC queues —
# ADR-002) AND the worker -> SSE Pub/Sub bridge on channel `pulse:events`
# (ADR-003). The local docker-compose.yml binds Redis to 6381. In production
# this points at Upstash Redis (single region `fra`).
REDIS_URL=redis://localhost:6381

# --- Phase 6: auth (ADR-006 / ADR-007, better-auth) — WIRED ---

# better-auth signing secret for sessions. Generate a long random string
# (e.g. `openssl rand -base64 32`). REQUIRED by the WEB process once the auth
# module is wired (Phase 6) — AuthService fails loudly at startup if it is
# missing (>=16 chars), so the auth surface never starts insecure.
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-secret

# better-auth canonical base URL = the API origin better-auth issues cookies /
# callbacks against. better-auth mounts under /api/auth/* on THIS origin.
#   - DEV: the API origin (http://localhost:3080). The web (:3081) is a
#     DIFFERENT origin, so the session cookie travels cross-site via CORS
#     `credentials: true` (main.ts) + `trustedOrigins` (= CORS_ORIGINS) and
#     `SameSite=Lax`; the dashboard fetch/EventSource use credentials:include.
#   - PROD: the deployed API origin BEHIND the pulse-web single-origin reverse
#     proxy (ADR-006), so the browser sees ONE origin, the cookie is
#     first-party + Secure, and the SSE EventSource is authenticated with no
#     special handling. Set this to the proxied API origin (the public web
#     origin if the proxy rewrites /api -> the API).
BETTER_AUTH_URL=http://localhost:3080

# --- Phase 5: alerting (ADR-005) — WIRED ---

# HMAC-SHA256 key used to sign outbound webhook payloads. SIGNING SCHEME a
# receiver verifies:
#   - body is the JSON alert payload; two headers travel with it:
#       X-Pulse-Timestamp: <unix-seconds>
#       X-Pulse-Signature: sha256=<hex of HMAC-SHA256(key, "<timestamp>.<rawBody>")>
#   - the receiver recomputes the HMAC over "<X-Pulse-Timestamp>.<rawBody>" with
#     the shared key, constant-time compares against X-Pulse-Signature, and
#     rejects a timestamp older than its tolerance (replay protection).
# Per-channel secrets live on alert_channels.secret and OVERRIDE this; this is
# the server-wide fallback used when a channel has no secret. If neither exists,
# the webhook dispatcher refuses to send an unsigned payload (records a failed
# delivery). Read by the WORKER process (the alert dispatch runs worker-side).
WEBHOOK_SIGNING_KEY=replace-me-with-a-webhook-hmac-key

# --- Phase 5: demo-incident mechanism (ADR-006) — WIRED ---

# Guards the owned flaky-endpoint demo trigger. When 'true' the web process
# serves `GET /demo/flaky` (200 normally, 500 while armed), `POST /demo/trigger`
# (arms a Redis-backed flag for ~20 s, then auto-recovers via the TTL), and
# `GET /demo/status`. When 'false' all three routes 404 so a deployed
# environment can disable the recruiter-facing trigger. Default 'true' in
# development. The flag is Redis-backed so the web (serves /demo/flaky) and the
# worker (probes the demo monitor) agree across the ADR-006 process split.
DEMO_TRIGGER_ENABLED=true

# --- Phase 3: SSE cross-origin dev posture (ADR-003 / ADR-006) ---

# Comma-separated allowlist of browser origins permitted to open the SSE
# streams (`/api/stream`, `/api/public/:slug/stream`) WITH CREDENTIALS — the
# dashboard EventSource carries the better-auth session cookie in Phase 6, and
# `credentials: true` forbids the `*` wildcard, so the origin must be explicit.
#
# DEV: the pulse-web dev origin (:3081), the default below — the local loop is
# two origins (web :3081 -> api :3080).
# PROD: the single-origin reverse-proxy posture (pulse-web proxies the API, the
# meld precedent) means the browser sees ONE origin and this is effectively
# unused; set it to the prod web origin (or empty) there. Never `*` with creds.
CORS_ORIGINS=http://localhost:3081
